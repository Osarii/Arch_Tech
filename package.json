{
  "name": "bim-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "lint": "tsc --noEmit",
    "i18n:extract": "i18next-cli extract --sync-primary",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:check": "npm run i18n:lint && npm run i18n:status",
    "server": "json-server --watch db.json --port 3001",
    "dev:portal": "node scripts/dev-portal.mjs",
    "postinstall": "node scripts/patch-web-ifc.js"
  },
  "dependencies": {
    "@thatopen/components": "^3.4.8",
    "@thatopen/components-front": "^3.4.4",
    "@thatopen/fragments": "^3.4.7",
    "camera-controls": "^3.1.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.9",
    "web-ifc": "^0.0.78",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "i18next-cli": "^1.74.8",
    "jsdom": "^26.0.0",
    "json-server": "^1.0.0-beta.15",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
